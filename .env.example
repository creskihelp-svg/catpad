# GEMINI_API_KEY: Optional/runtime for AI assistance or image enhancements
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# SOLANA CONFIGURATION
SOLANA_NETWORK="devnet" # or "mainnet-beta"
SOLANA_RPC_URL="https://api.devnet.solana.com"

# PUMP.FUN & PUMP FEES PROGRAM IDS
PUMPFUN_PROGRAM_ID="6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P"
PUMPFEES_PROGRAM_ID="pfeeUxB6jkeY1Hxd7CsFCAjcbHA9rWtchMGdZ6VojVZ"

# SUPABASE CONFIGURATION (Set these in production / Vercel deployment)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ADMIN AUTH (Used for server-side verification and fallback authentication)
ADMIN_SECRET_KEY="catpad-secure-admin-passphrase-change-me"
ADMIN_EMAIL="admin@catpad.fun"

# PUBLIC (VITE_) CONFIGURATION — exposed to the browser
# X handle used in the footer, meta tags and share links
VITE_X_HANDLE="catpadfun"
# Comma-separated wallet addresses allowed to see the admin entry point
VITE_ADMIN_WALLETS=""
# "Generate devnet test wallet" is always available in dev builds.
# Set to "true" only if you intentionally want it in a production build.
VITE_ENABLE_DEVNET_WALLET="false"
